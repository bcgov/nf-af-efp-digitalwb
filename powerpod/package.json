    "react-dom": "^18.2.0",
    "rollup-plugin-import-css": "^3.5.0",
    "rollup-plugin-terser": "^7.0.2",
    "storybook": "^7.6.13",
    "ts-jest": "^29.2.5",
    "typescript": "^5.3.3",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  },
  "dependencies": {
    "@lit/task": "^1.0.0",
    "@shoelace-style/shoelace": "^2.15.0",
    "fa-icons": "^0.2.0",
    "flatpickr": "^4.6.13",
